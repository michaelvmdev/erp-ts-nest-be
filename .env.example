# Copiar a `.env` y completar. `.env` esta en .gitignore: nunca subas credenciales.

NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
# En Vercel define solo DB_POSTGRES_URL con la URL del pooler de Supabase.
# En local puedes dejarla vacia y la app la construye con las variables de abajo.
DB_POSTGRES_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_contrasena
POSTGRES_DATABASE=dberp
POSTGRES_SSL=false

# Imprime en consola cada consulta que ejecuta TypeORM.
POSTGRES_LOGGING=false

# --- Rate-limiting ---
# Ventana en segundos y maximo de peticiones por IP y por endpoint en esa
# ventana. Al superarlo, la API responde 429 TOO_MANY_REQUESTS.
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Descomentar para apagar la documentacion Swagger en desarrollo.
# En produccion esta desactivada siempre, sin importar esta variable.
# SWAGGER_ENABLED=false

# --- Correo saliente (SMTP) ---
# Necesario solo para POST /sales/{saleId}/send-email. La app arranca sin esto;
# el envio falla con un mensaje claro hasta que se complete. MAIL_SECURE=true
# para el puerto 465 (SSL); false para 587 (STARTTLS).
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="AppSales <no-reply@appsales.local>"
