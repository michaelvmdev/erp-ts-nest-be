# ---------------------------------------------------------------------------
# Secretos y configuración local
# ---------------------------------------------------------------------------
# Lo más importante del archivo: un .env con la cadena de conexión a la base
# nunca debe llegar al repositorio.
.env
.env.*
*.env

# Las plantillas sí se versionan: documentan qué variables hay que definir.
!.env.example
!.env.template
!.env.sample

# Certificados y llaves
*.pem
*.key
*.p12
*.pfx
*.crt

# ---------------------------------------------------------------------------
# Dependencias
# ---------------------------------------------------------------------------
node_modules/
jspm_packages/
bower_components/
web_modules/

# Yarn Plug'n'Play
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------------------
# Compilación (TypeScript / NestJS)
# ---------------------------------------------------------------------------
dist/
build/
out/
tmp/
temp/
*.tsbuildinfo
.tsbuildinfo

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ---------------------------------------------------------------------------
# Tests y cobertura
# ---------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output/
.jest-cache/
test-results/
playwright-report/

# ---------------------------------------------------------------------------
# Caches de herramientas
# ---------------------------------------------------------------------------
.cache/
.npm/
.eslintcache
.stylelintcache
.parcel-cache/
.rollup.cache/
.swc/
.turbo/
.next/
.nuxt/
.node_repl_history
*.tgz
.grunt/

# ---------------------------------------------------------------------------
# Bases de datos y volcados
# ---------------------------------------------------------------------------
