*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
pgdata/

# ---------------------------------------------------------------------------
# Editores e IDEs
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.iml
*.swp
*.swo
*.sublime-workspace
*.sublime-project
.history/

